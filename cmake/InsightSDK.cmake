set(INSIGHT_SDK_ROOT "" CACHE PATH "Official insight-sdk checkout (pinned revision recommended)")
option(INSIGHT_SPLIT_USB "Insight7 PID 0104 separate RGB and depth interfaces" ON)
if(NOT INSIGHT_SDK_ROOT)
 include(FetchContent)
 FetchContent_Declare(insight_vendor GIT_REPOSITORY https://github.com/LooperRobotics/insight-sdk.git GIT_TAG 58395177ba3ecd077309e87549022fdcec3a9a4f)
 FetchContent_MakeAvailable(insight_vendor)
 set(INSIGHT_SDK_ROOT "${insight_vendor_SOURCE_DIR}")
endif()
set(SOURCE "${INSIGHT_SDK_ROOT}")
set(OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/insight-patched")
set(SPLIT_USB "${INSIGHT_SPLIT_USB}")
include("${CMAKE_CURRENT_LIST_DIR}/PrepareInsight.cmake")
set(vendor "${INSIGHT_SDK_ROOT}/Windows-SDK")
add_library(insight_sdk STATIC "${OUTPUT}/Insight9SDK.cpp" "${OUTPUT}/ExtensionUnitControl.cpp")
target_include_directories(insight_sdk PUBLIC "${vendor}" PRIVATE "${vendor}/hidapi-prebuilt/include" "${CMAKE_CURRENT_SOURCE_DIR}/src")
target_compile_definitions(insight_sdk PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
target_compile_options(insight_sdk PRIVATE /utf-8 /EHsc)
target_link_libraries(insight_sdk PRIVATE "${vendor}/hidapi-prebuilt/lib/hidapi.lib" strmiids ole32 oleaut32 mf mfplat mfreadwrite mfuuid propsys sensorsapi)
target_link_libraries(deepmirror PRIVATE insight_sdk)
target_sources(deepmirror PRIVATE src/windows_source.cpp)
target_compile_definitions(deepmirror PRIVATE DEEPMIRROR_WINDOWS_SDK)
if(INSIGHT_SPLIT_USB)
 target_compile_definitions(deepmirror PRIVATE DEEPMIRROR_SPLIT_USB)
endif()
add_custom_command(TARGET deepmirror POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different "${vendor}/hidapi-prebuilt/bin/hidapi.dll" "$<TARGET_FILE_DIR:deepmirror>")
